<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background -->
    <path
        android:fillColor="#08050F"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- EL-AI hexagon logo, scaled to sit inside the 66dp adaptive-icon safe zone -->
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="23"
        android:translateY="16.8">
        <group android:translateY="6">

            <!-- Dark violet core fill -->
            <path
                android:fillColor="#1F0E3A"
                android:pathData="M50,8 L90,31 L90,77 L50,100 L10,77 L10,31 Z" />

            <!-- Orbit ring -->
            <group
                android:rotation="-28"
                android:pivotX="50"
                android:pivotY="54">
            <path
                android:pathData="M3,54 A47,15 0 1,0 97,54 A47,15 0 1,0 3,54 Z"
                android:strokeWidth="1.4"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeAlpha="0.7">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="0"
                        android:endX="100"
                        android:endY="120">
                        <item android:offset="0" android:color="#22D3EE" />
                        <item android:offset="0.5" android:color="#A855F7" />
                        <item android:offset="1" android:color="#F0ABFC" />
                    </gradient>
                </aapt:attr>
            </path>
            </group>

            <!-- Outer hexagon -->
            <path
                android:pathData="M50,8 L90,31 L90,77 L50,100 L10,77 L10,31 Z"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="0"
                        android:endX="100"
                        android:endY="120">
                        <item android:offset="0" android:color="#22D3EE" />
                        <item android:offset="0.5" android:color="#A855F7" />
                        <item android:offset="1" android:color="#F0ABFC" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Inner hexagon -->
            <path
                android:pathData="M50,22 L78,38 L78,70 L50,86 L22,70 L22,38 Z"
                android:strokeWidth="1.2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeAlpha="0.55">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="0"
                        android:endX="100"
                        android:endY="120">
                        <item android:offset="0" android:color="#22D3EE" />
                        <item android:offset="0.5" android:color="#A855F7" />
                        <item android:offset="1" android:color="#F0ABFC" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- E glyph -->
            <path
                android:pathData="M38,40 H64 M38,53 H58 M38,66 H64 M38,40 V66"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="0"
                        android:endX="100"
                        android:endY="120">
                        <item android:offset="0" android:color="#22D3EE" />
                        <item android:offset="0.5" android:color="#A855F7" />
                        <item android:offset="1" android:color="#F0ABFC" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Corner nodes -->
            <path
                android:fillColor="#67E8F9"
                android:pathData="M46.5,8 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
            <path
                android:fillColor="#F0ABFC"
                android:pathData="M86.5,77 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
            <path
                android:fillColor="#A78BFA"
                android:pathData="M6.5,77 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />

        </group>
    </group>
</vector>
